{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (Vite handles the actual transpile/emit) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Pragmatic migration settings — deliberately loose for now.
       Every file compiles as real TS (catches typos, wrong prop names,
       bad imports, etc.) without demanding full interfaces everywhere on
       day one. Tighten incrementally: flip noImplicitAny/strict on once
       the codebase has settled, not as part of the initial conversion. */
    "strict": false,
    "noImplicitAny": false,
    "allowJs": true,
    "checkJs": false,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
