# Cloud Backend base URL.
VITE_CLOUD_API_URL=http://localhost:8001

# Shared secret this kiosk sends as X-Device-Key — must match DEVICE_API_KEY
# in the backend's .env. This device has no per-user login, so this key is
# what authorizes it to call the backend.
VITE_DEVICE_API_KEY=replace_with_a_long_random_secret
