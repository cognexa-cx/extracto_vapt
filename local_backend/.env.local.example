# ===============================
# MS SQL SERVER (SSMS) — same database Cloud Backend uses
# ===============================
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DB=extracto_db
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=your_password
SQL_SERVER_DRIVER=ODBC Driver 17 for SQL Server

# ===============================
# LOCAL IMAGE STORAGE
# ===============================
# Folder on disk where approved-record images (invoice pages + vehicle
# front/back) are saved. Served back out at /images/... by local_app.py.
LOCAL_STORAGE_DIR=C:\Users\you\Desktop\Extracto_local
# Absolute base URL for image links returned to the frontend — required
# whenever the web/tab app is on a different origin (port) than the
# backend, otherwise "/images/..." resolves against the WRONG server and
# images show as broken.
LOCAL_STORAGE_BASE_URL=http://192.168.10.213:8002

# ===============================
# LOGGING
# ===============================
# Structured JSON logs (every OCR/LLM call, extraction, approve/reject) are
# written to {LOG_DIR}/extracto.log, rotating at 10MB (5 backups kept).
LOG_DIR=./logs

# ===============================
# LOCAL BACKEND (local_app.py)
# ===============================
# Which port local_app.py listens on
LOCAL_BACKEND_PORT=8002

# ── Combination 1: PaddleOCR (PP-StructureV3) + NuExtract-3 Q4 via Ollama ──
# Ollama server URL (default assumes Ollama running on the same machine)
OLLAMA_BASE_URL=http://localhost:11434
# Model tag as pulled into Ollama, e.g.: ollama pull nuextract3:q4
OLLAMA_NUEXTRACT_MODEL=hf.co/numind/NuExtract3-GGUF:Q4_K_M

# PaddleOCR language code
PADDLEOCR_LANG=en
# "gpu:0" for CUDA (requires paddlepaddle-gpu, not the CPU-only package), or "cpu"
PADDLEOCR_DEVICE=gpu:0

# ===============================
# AUTH
# ===============================
# Secret used to sign/verify login JWTs. Generate with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_HOURS=8

# Shared secret the kiosk/tablet app sends as the X-Device-Key header
# (it has no per-user login). Generate the same way as JWT_SECRET.
DEVICE_API_KEY=replace_with_a_long_random_secret

# One-time seed admin account, created only if the users table is empty.
# Change the password after first login, then these two lines can be removed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_strong_password

# Comma-separated browser origins allowed to call this API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.10.213:5173
